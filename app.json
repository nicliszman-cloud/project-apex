{
  "expo": {
    "name": "StreetClub",
    "slug": "project-apex",
    "version": "0.5.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "projectapex",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O StreetClub acessa suas fotos para você publicar carros, projetos, eventos e peças.",
          "cameraPermission": "O StreetClub acessa sua câmera para você fotografar carros, projetos, eventos e peças.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.projectapex.app",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.projectapex.app",
      "versionCode": 2
    },
    "web": {
      "bundler": "metro"
    }
  }
}

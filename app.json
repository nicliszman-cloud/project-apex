{
  "expo": {
    "name": "StreetClub",
    "slug": "streetclub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "streetclub",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O StreetClub acessa suas fotos para você publicar carros, projetos, eventos e peças.",
          "cameraPermission": "O StreetClub acessa sua câmera para você fotografar carros, projetos, eventos e peças.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o StreetClub use sua localização enquanto o app estiver aberto para mostrar sua posição e eventos próximos no mapa."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nicliszman.streetclub",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.nicliszman.streetclub",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e45c3643-8093-42b9-87c9-805e66c80282"
      }
    },
    "owner": "niclisz"
  }
}
